# PostgreSQL connection (no Supabase). Use sslmode=require in production.
DATABASE_URL=postgres://acq:acq_dev@localhost:5432/acq_os
# 32+ random bytes, used to sign session cookies: `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string
# Set to "true" only in local/dev to allow loading labeled sample data
ALLOW_SAMPLE_DATA=true
# Global kill switch for external communications + paid AI actions (Phases 4-5)
EXTERNAL_ACTIONS_ENABLED=false
# DealMachine (Phase 2). Server-side only — never expose to the browser.
DEALMACHINE_API_KEY=
# Optional override (defaults to https://api.v2.dealmachine.com/v1)
DEALMACHINE_API_URL=
# Signing secret returned when the webhook is registered
DEALMACHINE_WEBHOOK_SECRET=
